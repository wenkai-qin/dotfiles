{
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": false,
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "permissions": {
    "allow": [
      "Bash(latexmk *)",
      "Bash(pdflatex *)",
      "Bash(xelatex *)",
      "Bash(lualatex *)",
      "Bash(bibtex *)",
      "Bash(biber *)",
      "Bash(latexdiff *)",
      "Bash(fig2dev *)",
      "Bash(make paper*)",
      "Bash(make all*)",
      "Bash(make diff*)",
      "Bash(make clean*)",
      "Bash(make supplementary*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git stash list*)",
      "Bash(git remote -v)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(fd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(pdfinfo *)",
      "Bash(pdftotext *)"
    ]
  }
}
